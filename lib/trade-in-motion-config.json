{
  "sections": [
    {
      "id": "personal",
      "title": "Datos personales",
      "description": "Escribe los datos como aparecen en tus documentos. Las direcciones se capturan por partes.",
      "fields": [
        {
          "key": "full_name",
          "label": "Nombre completo como aparece en tu pasaporte",
          "type": "text",
          "required": true
        },
        {
          "key": "birth_date",
          "label": "Fecha de nacimiento",
          "type": "date",
          "required": true
        },
        {
          "key": "birth_city",
          "label": "Ciudad donde naciste",
          "type": "text",
          "required": true
        },
        {
          "key": "birth_state",
          "label": "Estado / provincia donde naciste",
          "type": "select",
          "options": [
            "Aguascalientes",
            "Baja California",
            "Baja California Sur",
            "Campeche",
            "Chiapas",
            "Chihuahua",
            "Ciudad de México",
            "Coahuila",
            "Colima",
            "Durango",
            "Estado de México",
            "Guanajuato",
            "Guerrero",
            "Hidalgo",
            "Jalisco",
            "Michoacán",
            "Morelos",
            "Nayarit",
            "Nuevo León",
            "Oaxaca",
            "Puebla",
            "Querétaro",
            "Quintana Roo",
            "San Luis Potosí",
            "Sinaloa",
            "Sonora",
            "Tabasco",
            "Tamaulipas",
            "Tlaxcala",
            "Veracruz",
            "Yucatán",
            "Zacatecas",
            "Fuera de México / otro estado o provincia"
          ],
          "required": true
        },
        {
          "key": "birth_state_other",
          "label": "Estado o provincia donde naciste (fuera de México)",
          "type": "text",
          "when": {
            "key": "birth_state",
            "equals": "Fuera de México / otro estado o provincia"
          },
          "required": true
        },
        {
          "key": "birth_country",
          "label": "País donde naciste",
          "type": "text",
          "required": true
        },
        {
          "key": "marital_status",
          "label": "Estado civil",
          "type": "select",
          "options": [
            "Soltero(a)",
            "Casado(a)",
            "Unión libre",
            "Divorciado(a)",
            "Viudo(a)",
            "Separado(a)"
          ],
          "required": true
        },
        {
          "key": "nationality",
          "label": "Nacionalidad",
          "type": "text",
          "placeholder": "Por ejemplo, mexicana",
          "required": true
        },
        {
          "key": "other_nationality",
          "label": "¿Tienes o has tenido alguna otra nacionalidad aparte de la mexicana?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "help": "Contesta según tu situación real, incluyendo nacionalidades que hayas tenido anteriormente. Si no tienes otra nacionalidad, selecciona «No» y continúa; las preguntas adicionales se ocultarán."
        },
        {
          "key": "other_nationality_country",
          "label": "¿De qué otro país tienes o tuviste nacionalidad?",
          "type": "text",
          "placeholder": "Escribe el país",
          "when": {
            "key": "other_nationality",
            "equals": "Sí"
          },
          "required": true,
          "help": "Si has tenido más de una nacionalidad adicional, escríbelas todas. Este campo se revisará antes de trasladar la información a CEAC."
        },
        {
          "key": "spouse_name",
          "label": "Nombre completo de tu cónyuge / pareja",
          "type": "text",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_date",
          "label": "Fecha de nacimiento de tu cónyuge / pareja",
          "type": "date",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_city",
          "label": "Ciudad donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_state",
          "label": "Estado donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_country",
          "label": "País donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "former_spouse_name",
          "label": "Nombre completo del cónyuge anterior",
          "type": "text",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          },
          "help": "Para divorcio o viudez se solicitan datos de matrimonio anterior, no de pareja actual."
        },
        {
          "key": "former_spouse_birth_date",
          "label": "Fecha de nacimiento del cónyuge anterior",
          "type": "date",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        },
        {
          "key": "former_spouse_birth_city",
          "label": "Ciudad donde nació el cónyuge anterior",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        },
        {
          "key": "former_spouse_birth_state",
          "label": "Estado donde nació el cónyuge anterior",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        },
        {
          "key": "home_street",
          "label": "Calle y número · domicilio actual",
          "placeholder": "Calle y número",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_neighborhood",
          "label": "Colonia · domicilio actual",
          "placeholder": "Colonia",
          "inlinePrompt": true,
          "type": "text"
        },
        {
          "key": "home_city",
          "label": "Ciudad · domicilio actual",
          "placeholder": "Ciudad",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_state",
          "label": "Estado · domicilio actual",
          "placeholder": "Selecciona un estado",
          "inlinePrompt": true,
          "type": "select",
          "options": [
            "Aguascalientes",
            "Baja California",
            "Baja California Sur",
            "Campeche",
            "Chiapas",
            "Chihuahua",
            "Ciudad de México",
            "Coahuila",
            "Colima",
            "Durango",
            "Estado de México",
            "Guanajuato",
            "Guerrero",
            "Hidalgo",
            "Jalisco",
            "Michoacán",
            "Morelos",
            "Nayarit",
            "Nuevo León",
            "Oaxaca",
            "Puebla",
            "Querétaro",
            "Quintana Roo",
            "San Luis Potosí",
            "Sinaloa",
            "Sonora",
            "Tabasco",
            "Tamaulipas",
            "Tlaxcala",
            "Veracruz",
            "Yucatán",
            "Zacatecas",
            "Fuera de México / otro estado o provincia"
          ],
          "required": true
        },
        {
          "key": "home_state_other",
          "label": "Estado o provincia fuera de México · domicilio actual",
          "placeholder": "Escribe el estado o provincia",
          "inlinePrompt": true,
          "type": "text",
          "required": true,
          "when": {
            "key": "home_state",
            "equals": "Fuera de México / otro estado o provincia"
          }
        },
        {
          "key": "home_postal",
          "label": "Código postal · domicilio actual",
          "placeholder": "Código postal",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_country",
          "label": "País de tu domicilio fuera de México",
          "placeholder": "Escribe el país",
          "inlinePrompt": true,
          "type": "text",
          "when": {
            "key": "home_state",
            "equals": "Fuera de México / otro estado o provincia"
          },
          "required": true
        },
        {
          "key": "email",
          "label": "Correo electrónico",
          "type": "email",
          "required": true
        },
        {
          "key": "phone",
          "label": "Teléfono celular",
          "type": "tel",
          "required": true
        },
        {
          "key": "employer_phone",
          "label": "Teléfono del trabajo (opcional)",
          "type": "tel"
        },
        {
          "key": "social_media_used",
          "label": "¿En cuáles de estas redes sociales has tenido presencia en los últimos 5 años?",
          "type": "multiselect",
          "required": true,
          "options": [
            "Facebook",
            "Instagram",
            "X (antes Twitter)",
            "TikTok",
            "LinkedIn",
            "YouTube",
            "Snapchat",
            "Reddit",
            "Otra(s)",
            "Ninguna"
          ],
          "help": "Puedes seleccionar varias redes. Incluye cuentas que utilizas o utilizaste en ese periodo, aunque hoy estén inactivas. Si no has usado ninguna, selecciona «Ninguna». No compartas contraseñas."
        },
        {
          "key": "social_facebook",
          "label": "Usuario(s) o identificador(es) en Facebook",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "Facebook"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_instagram",
          "label": "Usuario(s) o identificador(es) en Instagram",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "Instagram"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_x",
          "label": "Usuario(s) o identificador(es) en X (antes Twitter)",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "X (antes Twitter)"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_tiktok",
          "label": "Usuario(s) o identificador(es) en TikTok",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "TikTok"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_linkedin",
          "label": "Usuario(s) o identificador(es) en LinkedIn",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "LinkedIn"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_youtube",
          "label": "Usuario(s) o identificador(es) en YouTube",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "YouTube"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_snapchat",
          "label": "Usuario(s) o identificador(es) en Snapchat",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "Snapchat"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_reddit",
          "label": "Usuario(s) o identificador(es) en Reddit",
          "type": "text",
          "placeholder": "@usuario1, @usuario2 (si aplica)",
          "when": {
            "key": "social_media_used",
            "includes": "Reddit"
          },
          "help": "Si tuviste más de una cuenta, anota todos los usuarios que hayas usado en los últimos 5 años.",
          "required": true
        },
        {
          "key": "social_other",
          "label": "Otras redes sociales y sus usuarios o identificadores",
          "type": "textarea",
          "placeholder": "Plataforma — usuario o identificador (uno por línea)",
          "when": {
            "key": "social_media_used",
            "includes": "Otra(s)"
          },
          "help": "Escribe el nombre de la plataforma y cada usuario utilizado durante los últimos 5 años, uno por línea.",
          "required": true
        },
        {
          "key": "social_media_public",
          "label": "¿Tus perfiles de redes sociales están configurados como públicos o abiertos?",
          "type": "select",
          "options": [
            "Sí, todos están públicos o abiertos",
            "Aún no, tengo perfiles privados"
          ],
          "required": true,
          "when": {
            "key": "social_media_used",
            "nonempty": true,
            "notEquals": "Ninguna"
          },
          "help": "Para visa TN/TD, el Departamento de Estado indica que todos los perfiles deben estar públicos o abiertos para facilitar la revisión consular."
        }
      ]
    },
    {
      "id": "passport",
      "title": "Pasaporte",
      "description": "Ten a la mano el pasaporte para verificar números y fechas exactas.",
      "fields": [
        {
          "key": "passport_number",
          "label": "Número de pasaporte",
          "type": "text",
          "required": true
        },
        {
          "key": "passport_issue_city",
          "label": "Ciudad donde tramitaste tu pasaporte",
          "type": "text"
        },
        {
          "key": "passport_issued",
          "label": "Fecha de expedición del pasaporte",
          "type": "date",
          "required": true
        },
        {
          "key": "passport_expires",
          "label": "Fecha de vencimiento del pasaporte",
          "type": "date",
          "required": true
        },
        {
          "key": "passport_lost",
          "label": "¿Alguna vez perdiste o te robaron un pasaporte?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "passport_lost_date",
          "label": "Fecha aproximada de pérdida o robo del pasaporte",
          "type": "date",
          "when": {
            "key": "passport_lost",
            "equals": "Sí"
          }
        },
        {
          "key": "passport_lost_details",
          "label": "Explica lo ocurrido con el pasaporte",
          "type": "textarea",
          "when": {
            "key": "passport_lost",
            "equals": "Sí"
          }
        }
      ]
    },
    {
      "id": "travel",
      "title": "Tu próximo viaje",
      "description": "Contesta lo que sabes; Visa Master revisará los datos requeridos para el DS-160.",
      "fields": [
        {
          "key": "travel_date",
          "label": "Fecha aproximada de tu viaje",
          "type": "date"
        },
        {
          "key": "travel_more_than_24h",
          "label": "¿Planeas quedarte más de 24 horas?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true
        },
        {
          "key": "travel_duration_amount",
          "label": "¿Cuánto tiempo planeas permanecer en EE. UU.? (cantidad)",
          "type": "number",
          "help": "Escribe solo el número, por ejemplo 7."
        },
        {
          "key": "travel_duration_unit",
          "label": "Unidad de tiempo",
          "type": "select",
          "options": [
            "Días",
            "Semanas",
            "Meses"
          ]
        },
        {
          "key": "travel_stay_city",
          "label": "Ciudad donde te hospedarás",
          "type": "text",
          "when": {
            "key": "travel_more_than_24h",
            "equals": "Sí"
          },
          "required": true,
          "help": "No inventes una dirección si todavía no sabes dónde te hospedarás."
        },
        {
          "key": "travel_stay_address",
          "label": "Dirección donde te hospedarás",
          "type": "text",
          "when": {
            "key": "travel_more_than_24h",
            "equals": "Sí"
          },
          "required": true,
          "help": "Obligatorio en Visa Master cuando planeas quedarte más de 24 horas."
        },
        {
          "key": "travel_payer",
          "label": "¿Quién pagará los gastos de tu viaje?",
          "type": "select",
          "options": [
            "Yo mismo(a)",
            "Un familiar",
            "Otra persona",
            "Mi empleador actual",
            "Empresa en Estados Unidos",
            "Otra empresa u organización"
          ],
          "required": true
        },
        {
          "key": "travel_payer_person_name",
          "label": "Nombre completo de la persona que pagará",
          "type": "text",
          "when": {
            "key": "travel_payer",
            "equals": [
              "Un familiar",
              "Otra persona"
            ]
          },
          "required": true
        },
        {
          "key": "travel_payer_relationship",
          "label": "Parentesco o relación con quien pagará",
          "type": "select",
          "options": [
            "Cónyuge / pareja",
            "Padre",
            "Madre",
            "Hijo(a)",
            "Hermano(a)",
            "Abuelo(a)",
            "Nieto(a)",
            "Tío(a)",
            "Primo(a)",
            "Otro familiar"
          ],
          "when": {
            "key": "travel_payer",
            "equals": [
              "Un familiar",
              "Otra persona"
            ]
          },
          "required": true
        },
        {
          "key": "travel_payer_organization",
          "label": "Nombre de la empresa u organización que pagará",
          "type": "text",
          "when": {
            "key": "travel_payer",
            "equals": [
              "Mi empleador actual",
              "Empresa en Estados Unidos",
              "Otra empresa u organización"
            ]
          },
          "required": true
        },
        {
          "key": "travel_with_someone",
          "label": "¿Viajarás con alguien?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true
        }
      ]
    },
    {
      "id": "history",
      "title": "Historial migratorio",
      "description": "Las fechas se seleccionan en calendarios. Nunca respondas por suposición.",
      "fields": [
        {
          "key": "visited_us",
          "label": "¿Has visitado Estados Unidos antes?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "last_visit_date",
          "label": "Fecha de tu última visita a EE. UU.",
          "type": "date",
          "when": {
            "key": "visited_us",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "last_visit_duration_days",
          "label": "¿Cuántos días duró tu última visita?",
          "type": "number",
          "when": {
            "key": "visited_us",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa",
          "label": "¿Has tenido una visa estadounidense?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true
        },
        {
          "key": "prior_visa_issued_city",
          "label": "Ciudad donde te expidieron la visa",
          "type": "select",
          "options": [
            "Ciudad de México",
            "Ciudad Juárez",
            "Guadalajara",
            "Hermosillo",
            "Matamoros",
            "Mérida",
            "Monterrey",
            "Nogales",
            "Nuevo Laredo",
            "Tijuana",
            "Otra ciudad o país"
          ],
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa_issued_other",
          "label": "Indica la ciudad y país de expedición",
          "type": "text",
          "when": {
            "key": "prior_visa_issued_city",
            "equals": "Otra ciudad o país"
          },
          "required": true
        },
        {
          "key": "prior_visa_issue_date",
          "label": "Fecha de expedición de la visa",
          "type": "date",
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa_expiration_date",
          "label": "Fecha de vencimiento de la visa",
          "type": "date",
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "visa_denial",
          "label": "¿Te han negado o cancelado una visa o negado la entrada a EE. UU.?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_denial_kind",
          "label": "¿Qué ocurrió?",
          "type": "select",
          "options": [
            "Negación de visa",
            "Cancelación / revocación de visa",
            "Negación de entrada a Estados Unidos",
            "Más de una de las anteriores"
          ],
          "when": {
            "key": "visa_denial",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_denial_date",
          "label": "Fecha aproximada del incidente",
          "type": "date",
          "when": {
            "key": "visa_denial",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "visa_denial_details",
