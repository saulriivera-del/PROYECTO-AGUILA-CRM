{
  "sections": [
    {
      "id": "personal",
      "title": "Datos personales",
      "description": "Solo tus datos de identidad, nacimiento y estado civil. Lo demás va en pasos separados.",
      "fields": [
        {
          "key": "visa_profile",
          "label": "¿Qué tipo de visa vas a tramitar?",
          "type": "select",
          "options": [
            "TN",
            "TD_CONYUGE",
            "TD_HIJO",
            "B1/B2"
          ],
          "required": true,
          "help": "Selecciona la categoría indicada por Visa Master. Para TD se solicitan los nombres del titular principal TN; para B1/B2 se muestran las opciones de visitante."
        },
        {
          "key": "full_name",
          "label": "Nombre(s), sin apellidos, como aparecen en tu pasaporte",
          "type": "text",
          "required": true
        },
        {
          "key": "curp_paterno",
          "label": "Primer apellido",
          "type": "text"
        },
        {
          "key": "curp_materno",
          "label": "Segundo apellido",
          "type": "text",
          "help": "Si no tienes segundo apellido, puedes dejarlo en blanco."
        },
        {
          "key": "curp_sexo",
          "label": "Sexo",
          "type": "select",
          "options": [
            "Hombre",
            "Mujer"
          ]
        },
        {
          "key": "birth_date",
          "label": "Fecha de nacimiento",
          "type": "date",
          "required": true
        },
        {
          "key": "birth_city",
          "label": "Ciudad donde naciste",
          "type": "text",
          "required": true
        },
        {
          "key": "birth_state",
          "label": "Estado / provincia donde naciste",
          "type": "select",
          "options": [
            "Aguascalientes",
            "Baja California",
            "Baja California Sur",
            "Campeche",
            "Chiapas",
            "Chihuahua",
            "Ciudad de México",
            "Coahuila",
            "Colima",
            "Durango",
            "Estado de México",
            "Guanajuato",
            "Guerrero",
            "Hidalgo",
            "Jalisco",
            "Michoacán",
            "Morelos",
            "Nayarit",
            "Nuevo León",
            "Oaxaca",
            "Puebla",
            "Querétaro",
            "Quintana Roo",
            "San Luis Potosí",
            "Sinaloa",
            "Sonora",
            "Tabasco",
            "Tamaulipas",
            "Tlaxcala",
            "Veracruz",
            "Yucatán",
            "Zacatecas",
            "Fuera de México / otro estado o provincia"
          ],
          "required": true
        },
        {
          "key": "birth_state_other",
          "label": "Estado o provincia donde naciste (fuera de México)",
          "type": "text",
          "when": {
            "key": "birth_state",
            "equals": "Fuera de México / otro estado o provincia"
          },
          "required": true
        },
        {
          "key": "birth_country",
          "label": "País donde naciste",
          "type": "select",
          "required": true,
          "help": "Selecciona el país donde realmente naciste. México aparece destacado. Esta respuesta se utilizará para preparar el DS-160."
        },
        {
          "key": "birth_country_nonmexico_confirmed",
          "label": "Confirmación de nacimiento fuera de México",
          "type": "select",
          "required": true,
          "options": [
            "Sí, confirmo que nací fuera de México"
          ],
          "when": {
            "key": "birth_country",
            "nonempty": true,
            "notEquals": "MX"
          },
          "help": "Es obligatorio confirmar si eliges un país distinto de México."
        },
        {
          "key": "curp_valor",
          "label": "CURP confirmada por el solicitante",
          "type": "text",
          "help": "Solo se usa la CURP comprobada en tus documentos; el cálculo preliminar no es oficial."
        },
        {
          "key": "curp_confirmada",
          "label": "Estado de confirmación de CURP",
          "type": "select",
          "options": [
            "Sí, coincide con mi documento",
            "No, la corregí con mi documento"
          ]
        },
        {
          "key": "marital_status",
          "label": "Estado civil",
          "type": "select",
          "options": [
            "Soltero(a)",
            "Casado(a)",
            "Unión libre",
            "Divorciado(a)",
            "Viudo(a)",
            "Separado(a)"
          ],
          "required": true
        },
        {
          "key": "nationality",
          "label": "Nacionalidad",
          "type": "text",
          "placeholder": "Mexicana",
          "required": true,
          "help": "Si tienes otra nacionalidad, puedes cambiar este dato."
        },
        {
          "key": "other_names_used",
          "label": "¿Has utilizado otros nombres, apellidos, seudónimos o alias?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "help": "Incluye apellido de soltera, nombre religioso, profesional o cualquier otro nombre con el que te hayan conocido. Contesta de acuerdo con tus antecedentes reales."
        },
        {
          "key": "other_names_details",
          "label": "Escribe los nombres o apellidos adicionales que has utilizado",
          "type": "textarea",
          "required": true,
          "when": {
            "key": "other_names_used",
            "equals": "Sí"
          },
          "help": "Anota cada nombre completo utilizado. Visa Master lo verificará antes de pasarlo a la solicitud oficial."
        },
        {
          "key": "name_telecode",
          "label": "¿Tienes un telecódigo que represente tu nombre?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "help": "El telecódigo se utiliza para representar ciertos nombres escritos en alfabetos no latinos. No es tu CURP."
        },
        {
          "key": "name_telecode_value",
          "label": "Escribe tu telecódigo de nombre",
          "type": "text",
          "required": true,
          "when": {
            "key": "name_telecode",
            "equals": "Sí"
          },
          "help": "Confirma el código exacto con tu documentación."
        },
        {
          "key": "spouse_name",
          "label": "Nombre completo de tu cónyuge / pareja",
          "type": "text",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_date",
          "label": "Fecha de nacimiento de tu cónyuge / pareja",
          "type": "date",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_city",
          "label": "Ciudad donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_state",
          "label": "Estado donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "spouse_birth_country",
          "label": "País donde nació tu cónyuge / pareja",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Casado(a)",
              "Unión libre",
              "Separado(a)"
            ]
          }
        },
        {
          "key": "former_spouse_name",
          "label": "Nombre completo del cónyuge anterior",
          "type": "text",
          "required": true,
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          },
          "help": "Para divorcio o viudez se solicitan datos de matrimonio anterior, no de pareja actual."
        },
        {
          "key": "former_spouse_birth_date",
          "label": "Fecha de nacimiento del cónyuge anterior",
          "type": "date",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        },
        {
          "key": "former_spouse_birth_city",
          "label": "Ciudad donde nació el cónyuge anterior",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        },
        {
          "key": "former_spouse_birth_state",
          "label": "Estado donde nació el cónyuge anterior",
          "type": "text",
          "when": {
            "key": "marital_status",
            "equals": [
              "Divorciado(a)",
              "Viudo(a)"
            ]
          }
        }
      ]
    },
    {
      "id": "travel",
      "title": "Tu próximo viaje",
      "description": "Solo preguntaremos los datos que correspondan a tu categoría y a tus planes de viaje.",
      "fields": [
        {
          "key": "travel_plans_specific",
          "label": "¿Ya tienes planes específicos de viaje (fechas y lugares confirmados)?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "help": "Marca Sí si ya sabes cuándo y a dónde viajarás; si aún no tienes itinerario definitivo, marca No."
        },
        {
          "key": "td_principal_surnames",
          "label": "Apellidos del titular de visa TN",
          "type": "text",
          "visaProfiles": [
            "TD_CONYUGE",
            "TD_HIJO"
          ],
          "required": true,
          "help": "Apellidos del trabajador principal TN, tal como aparecen en su pasaporte. No son los apellidos del empleador."
        },
        {
          "key": "td_principal_given_names",
          "label": "Nombre(s) del titular de visa TN",
          "type": "text",
          "visaProfiles": [
            "TD_CONYUGE",
            "TD_HIJO"
          ],
          "required": true,
          "help": "Nombre(s) del trabajador principal TN, sin apellidos."
        },
        {
          "key": "travel_date",
          "label": "Fecha prevista de llegada a Estados Unidos",
          "type": "date"
        },
        {
          "key": "travel_duration_amount",
          "label": "Cantidad de días, semanas o meses",
          "type": "number",
          "help": "Escribe solo el número, por ejemplo 7.",
          "required": true,
          "when": {
            "key": "travel_duration_unit",
            "notEquals": "Menos de 24 horas"
          }
        },
        {
          "key": "travel_duration_unit",
          "label": "Duración prevista de tu estancia",
          "type": "select",
          "options": [
            "Días",
            "Semanas",
            "Meses",
            "Menos de 24 horas"
          ],
          "required": true,
          "help": "En B1/B2 puedes elegir «Menos de 24 horas» si corresponde a tu visita. No uses esa opción para TN o TD."
        },
        {
          "key": "travel_stay_city",
          "label": "Ciudad donde te hospedarás",
          "type": "text",
          "when": {
            "key": "travel_duration_unit",
            "notEquals": "Menos de 24 horas"
          },
          "required": true,
          "help": "Ciudad del destino en Estados Unidos."
        },
        {
          "key": "travel_stay_address",
          "label": "Dirección donde te hospedarás",
          "type": "text",
          "when": {
            "key": "travel_duration_unit",
            "notEquals": "Menos de 24 horas"
          },
          "required": true,
          "help": "Indica dónde planeas alojarte o llegar. No inventes una dirección si aún no la conoces; solicítanos ayuda para revisar el caso."
        },
        {
          "key": "travel_payer",
          "label": "¿Quién pagará los gastos de tu viaje?",
          "type": "select",
          "options": [
            "Yo mismo(a)",
            "Un familiar",
            "Otra persona",
            "Mi empleador actual",
            "Empresa en Estados Unidos",
            "Otra empresa u organización"
          ],
          "required": true
        },
        {
          "key": "travel_payer_person_name",
          "label": "Nombre completo de la persona que pagará",
          "type": "text",
          "when": {
            "key": "travel_payer",
            "equals": [
              "Un familiar",
              "Otra persona"
            ]
          },
          "required": true
        },
        {
          "key": "travel_payer_relationship",
          "label": "Parentesco o relación con quien pagará",
          "type": "select",
          "options": [
            "Cónyuge / pareja",
            "Padre",
            "Madre",
            "Hijo(a)",
            "Hermano(a)",
            "Abuelo(a)",
            "Nieto(a)",
            "Tío(a)",
            "Primo(a)",
            "Otro familiar"
          ],
          "when": {
            "key": "travel_payer",
            "equals": [
              "Un familiar",
              "Otra persona"
            ]
          },
          "required": true
        },
        {
          "key": "travel_payer_organization",
          "label": "Nombre de la empresa u organización que pagará",
          "type": "text",
          "when": {
            "key": "travel_payer",
            "equals": [
              "Mi empleador actual",
              "Empresa en Estados Unidos",
              "Otra empresa u organización"
            ]
          },
          "required": true
        },
        {
          "key": "travel_with_someone",
          "label": "¿Viajarás con alguien?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true
        },
        {
          "key": "travel_companions_group",
          "label": "¿Viajas como parte de un grupo u organización?",
          "type": "select",
          "when": {
            "key": "travel_with_someone",
            "equals": "Sí"
          },
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "help": "No es lo mismo viajar con familiares que pertenecer a un grupo organizado."
        },
        {
          "key": "travel_companions_group_name",
          "label": "Nombre del grupo u organización",
          "type": "text",
          "when": {
            "key": "travel_companions_group",
            "equals": "Sí"
          },
          "required": true
        }
      ]
    },
    {
      "id": "history",
      "title": "Historial migratorio",
      "description": "Las fechas se seleccionan en calendarios. Nunca respondas por suposición.",
      "fields": [
        {
          "key": "visited_us",
          "label": "¿Has visitado Estados Unidos antes?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "last_visit_date",
          "label": "Fecha de tu última visita a EE. UU.",
          "type": "date",
          "when": {
            "key": "visited_us",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "last_visit_duration_days",
          "label": "¿Cuántos días duró tu última visita?",
          "type": "number",
          "when": {
            "key": "visited_us",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa",
          "label": "¿Has tenido una visa estadounidense?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true
        },
        {
          "key": "prior_visa_issued_city",
          "label": "Ciudad donde te expidieron la visa",
          "type": "select",
          "options": [
            "Ciudad de México",
            "Ciudad Juárez",
            "Guadalajara",
            "Hermosillo",
            "Matamoros",
            "Mérida",
            "Monterrey",
            "Nogales",
            "Nuevo Laredo",
            "Tijuana",
            "Otra ciudad o país"
          ],
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa_issued_other",
          "label": "Indica la ciudad y país de expedición",
          "type": "text",
          "when": {
            "key": "prior_visa_issued_city",
            "equals": "Otra ciudad o país"
          },
          "required": true
        },
        {
          "key": "prior_visa_issue_date",
          "label": "Fecha de expedición de la visa",
          "type": "date",
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "prior_visa_expiration_date",
          "label": "Fecha de vencimiento de la visa",
          "type": "date",
          "when": {
            "key": "prior_visa",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "visa_denial",
          "label": "¿Te han negado o cancelado una visa o negado la entrada a EE. UU.?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_denial_kind",
          "label": "¿Qué ocurrió?",
          "type": "select",
          "options": [
            "Negación de visa",
            "Cancelación / revocación de visa",
            "Negación de entrada a Estados Unidos",
            "Más de una de las anteriores"
          ],
          "when": {
            "key": "visa_denial",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_denial_date",
          "label": "Fecha aproximada del incidente",
          "type": "date",
          "when": {
            "key": "visa_denial",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "visa_denial_details",
          "label": "Explica qué ocurrió",
          "type": "textarea",
          "when": {
            "key": "visa_denial",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_lost",
          "label": "¿Alguna vez perdiste o te robaron una visa?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "visa_lost_date",
          "label": "Fecha aproximada de pérdida o robo de visa",
          "type": "date",
          "when": {
            "key": "visa_lost",
            "equals": "Sí"
          }
        },
        {
          "key": "visa_lost_details",
          "label": "Describe lo sucedido",
          "type": "textarea",
          "when": {
            "key": "visa_lost",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "us_immigration_problem",
          "label": "¿Has tenido algún problema con migración o autoridades en EE. UU.?",
          "type": "select",
          "options": [
            "Sí",
            "No"
          ],
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "us_immigration_problem_type",
          "label": "Tipo de situación",
          "type": "select",
          "options": [
            "Detención migratoria",
            "Deportación / expulsión",
            "Permanencia mayor a la autorizada",
            "Problema en el puerto de entrada",
            "Otro"
          ],
          "when": {
            "key": "us_immigration_problem",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        },
        {
          "key": "us_immigration_problem_date",
          "label": "Fecha aproximada de la situación",
          "type": "date",
          "when": {
            "key": "us_immigration_problem",
            "equals": "Sí"
          },
          "required": true
        },
        {
          "key": "us_immigration_problem_details",
          "label": "Describe qué ocurrió",
          "type": "textarea",
          "when": {
            "key": "us_immigration_problem",
            "equals": "Sí"
          },
          "required": true,
          "reviewFlag": true
        }
      ]
    },
    {
      "id": "contact",
      "title": "Domicilio y contacto",
      "description": "Tu domicilio, teléfono y correo para el DS-160.",
      "fields": [
        {
          "key": "home_street",
          "label": "Calle y número · domicilio actual",
          "placeholder": "Calle y número",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_neighborhood",
          "label": "Colonia · domicilio actual",
          "placeholder": "Colonia",
          "inlinePrompt": true,
          "type": "text"
        },
        {
          "key": "home_city",
          "label": "Ciudad · domicilio actual",
          "placeholder": "Ciudad",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_state",
          "label": "Estado · domicilio actual",
          "placeholder": "Selecciona un estado",
          "inlinePrompt": true,
          "type": "select",
          "options": [
            "Aguascalientes",
            "Baja California",
            "Baja California Sur",
            "Campeche",
            "Chiapas",
            "Chihuahua",
            "Ciudad de México",
            "Coahuila",
            "Colima",
            "Durango",
            "Estado de México",
            "Guanajuato",
            "Guerrero",
            "Hidalgo",
            "Jalisco",
            "Michoacán",
            "Morelos",
            "Nayarit",
            "Nuevo León",
            "Oaxaca",
            "Puebla",
            "Querétaro",
            "Quintana Roo",
            "San Luis Potosí",
            "Sinaloa",
            "Sonora",
            "Tabasco",
            "Tamaulipas",
            "Tlaxcala",
            "Veracruz",
            "Yucatán",
            "Zacatecas",
            "Fuera de México / otro estado o provincia"
          ],
          "required": true
        },
        {
          "key": "home_state_other",
          "label": "Estado o provincia fuera de México · domicilio actual",
          "placeholder": "Escribe el estado o provincia",
          "inlinePrompt": true,
          "type": "text",
          "required": true,
          "when": {
            "key": "home_state",
            "equals": "Fuera de México / otro estado o provincia"
          }
        },
        {
          "key": "home_postal",
          "label": "Código postal · domicilio actual",
          "placeholder": "Código postal",
          "inlinePrompt": true,
          "type": "text",
          "required": true
        },
        {
          "key": "home_country",
          "label": "País de tu domicilio fuera de México",
          "placeholder": "Escribe el país",
          "inlinePrompt": true,
          "type": "text",
          "when": {
            "key": "home_state",
            "equals": "Fuera de México / otro estado o provincia"
          },
          "required": true
        },
        {
          "key": "email",
